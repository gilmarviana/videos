{
  "name": "plataforma-cursos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest --config vitest.config.mjs",
    "test:run": "vitest run --config vitest.config.mjs",
    "test:unit": "vitest run src/test/unit --config vitest.config.mjs",
    "test:integration": "vitest run src/test/integration --config vitest.config.mjs",
    "test:e2e": "vitest run src/test/e2e --config vitest.config.mjs",
    "test:performance": "vitest run src/test/performance --config vitest.config.mjs",
    "test:coverage": "vitest run --coverage --config vitest.config.mjs",
    "test:watch": "vitest watch --config vitest.config.mjs",
    "test:ui": "vitest --ui --config vitest.config.mjs",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "validate:webhook-system": "node validate-webhook-system.js"
  },
  "dependencies": {
    "@stripe/stripe-js": "^7.9.0",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.5",
    "@types/uuid": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "ioredis": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "next": "15.5.4",
    "nodemailer": "^7.0.6",
    "openai": "^5.23.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "redis": "^5.8.2",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.3.1",
    "uuid": "^13.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
